# Environment Variables

# Backend API Settings
PORT=8000
ENVIRONMENT=development

# Database Settings
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resiliencepay
# For docker-compose, use the service name 'postgres' instead of 'localhost'
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/resiliencepay

# Phase 11: Resilience/Chaos Testing (Optional)
# FAULT_INJECTION_ENABLED=False
# FAULT_INJECTION_RATE=0.0

# Upstash Redis
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# LLM 
GEMINI_API_KEY=""

# Redis Settings
REDIS_URL=redis://localhost:6379/0
# For docker-compose:
# REDIS_URL=redis://redis:6379/0

# Razorpay API Keys (Test Mode)
RAZORPAY_KEY_ID=your_test_key_id_here
RAZORPAY_KEY_SECRET=your_test_key_secret_here

# Anthropic API Key (Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
